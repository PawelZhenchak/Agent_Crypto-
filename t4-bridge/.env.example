# Prywatna konfiguracja wyłącznie procesu .NET. Nie commituj prawdziwych wartości.
T4_BRIDGE_PORT=8784
T4_BRIDGE_TOKEN=

# Oficjalna sesja wymaga prywatnej kopii katalogu schema v2 oraz klucza API.
T4_CONTRACT_CATALOG_PATH=
T4_API_ENVIRONMENT=pending
T4_API_KEY=

# Klucz dowodowy to prywatny ECDSA P-256 PKCS#8 PEM w pliku poza repozytorium.
T4_EVIDENCE_SIGNING_KEY_PATH=
# Ten append-only JSONL musi znajdować się na trwałym wolumenie.
T4_OBSERVATION_EVENT_JOURNAL_PATH=
T4_OBSERVATION_CAMPAIGN_ID=

# Kontrola scenariuszy jest domyślnie wyłączona i ma osobny token.
T4_OBSERVATION_CONTROL_ENABLED=false
T4_OBSERVATION_CONTROL_TOKEN=
