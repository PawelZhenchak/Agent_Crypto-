# Agent analizuje wyłącznie Plus500 Futures / T4.
CRYPTO_AGENT_ENV=development
CRYPTO_AGENT_DATA_PROVIDER=t4
CRYPTO_AGENT_DATABASE_PATH=var/crypto_agent_plus500_t4.db
CRYPTO_AGENT_RISK_POLICY_PATH=configs/risk_policy.v1.json

# Lokalny worker .NET utrzymuje sesję T4 i wystawia tylko dane rynkowe.
# Login i hasło T4 NIE mogą znajdować się w tym pliku ani w procesie analitycznym.
CRYPTO_AGENT_T4_BRIDGE_URL=http://127.0.0.1:8784
# Obecny token danych jest współdzielony przez bridge, verifier i runtime.
# Minimum 32 znaki.
CRYPTO_AGENT_T4_BRIDGE_TOKEN=
CRYPTO_AGENT_T4_TIMEOUT_SECONDS=10
CRYPTO_AGENT_ANALYSIS_TIMEOUT_SECONDS=30
# Runtime rozmawia z osobnym verifierem tylko po loopback HTTP. Ten token znają
# wyłącznie runtime i verifier; nie może być tokenem bridge'a ani sterowania.
CRYPTO_AGENT_EVIDENCE_VERIFIER_URL=http://127.0.0.1:8791
CRYPTO_AGENT_EVIDENCE_VERIFIER_TOKEN=
CRYPTO_AGENT_EVIDENCE_VERIFIER_TIMEOUT_SECONDS=10

# Nie umieszczaj tu prywatnej konfiguracji bridge'a. Katalog T4, klucz API,
# klucz podpisujący, journal i UUID kampanii należą do trzeciego, bridge-only
# UID oraz pliku opartego na t4-bridge/.env.example. Control token występuje
# tylko w rozłącznych plikach bridge'a i verifiera.

# Opcjonalna warstwa opisowa. Nie może zmienić decyzji risk gate.
CRYPTO_AGENT_ENABLE_LLM=false
OPENAI_API_KEY=
CRYPTO_AGENT_OPENAI_MODEL=gpt-5.6

# Wyłącznie lokalny PostgreSQL z compose.yaml. Obie wartości uzupełnij przed startem.
# Hasło ma być unikalne; nie commituj wypełnionego pliku .env.
POSTGRES_PASSWORD=
# Używane przez polecenia `crypto-agent db ...`; zachowaj DSN poza logami.
CRYPTO_AGENT_POSTGRES_DSN=
CRYPTO_AGENT_POSTGRES_CONNECT_TIMEOUT=5

# CRYPTO_AGENT_POSTGRES_EVIDENCE_DSN, CRYPTO_AGENT_POSTGRES_EVIDENCE_READ_DSN
# i pin klucza należą wyłącznie do osobnego procesu verifiera. Control token
# znają bridge i verifier, nigdy runtime. Zobacz
# configs/evidence-verifier.env.example; nie dodawaj tych wartości do
# środowiska runtime/CLI.
