# Plik 0600, właściciel crypto-runtime. Bez klucza T4, klucza podpisującego,
# tokenu sterowania scenariuszami i poświadczeń verifiera.
CRYPTO_AGENT_OBSERVATION_CAMPAIGN_ID=
CRYPTO_AGENT_SUPERVISOR_STATE_DIRECTORY=/var/lib/crypto-agent-supervisor
CRYPTO_AGENT_SUPERVISOR_PROCESS_MANAGER=systemd
CRYPTO_AGENT_SUPERVISOR_BRIDGE_UNIT=crypto-agent-t4-bridge.service
CRYPTO_AGENT_SUPERVISOR_VERIFIER_UNIT=crypto-agent-evidence-verifier.service
CRYPTO_AGENT_SUPERVISOR_RESTART_COOLDOWN_SECONDS=30
