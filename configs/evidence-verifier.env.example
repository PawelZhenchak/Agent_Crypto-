# Wyłącznie środowisko procesu `crypto-agent evidence-verifier`.
# Plik powinien mieć tryb 0600 i właściciela innego niż runtime oraz bridge.
CRYPTO_AGENT_POSTGRES_EVIDENCE_DSN=
# Osobny LOGIN należący wyłącznie do crypto_agent_evidence_reader.
CRYPTO_AGENT_POSTGRES_EVIDENCE_READ_DSN=
CRYPTO_AGENT_POSTGRES_CONNECT_TIMEOUT=5
CRYPTO_AGENT_T4_BRIDGE_URL=http://127.0.0.1:8784
# Obecny token danych bridge'a jest współdzielony przez trzy procesy.
CRYPTO_AGENT_T4_BRIDGE_TOKEN=
CRYPTO_AGENT_T4_TIMEOUT_SECONDS=10
CRYPTO_AGENT_T4_EVIDENCE_KEY_FINGERPRINT=
CRYPTO_AGENT_T4_EVIDENCE_PUBLIC_KEY_SPKI_BASE64=
# Token sterowania znają tylko bridge i verifier, nigdy runtime.
CRYPTO_AGENT_T4_OBSERVATION_CONTROL_TOKEN=
# Token API verifiera znają tylko verifier i runtime.
CRYPTO_AGENT_EVIDENCE_VERIFIER_TOKEN=
